  "cards": [
    {
      "dot": "cyan",
      "title": "为什么隔离",
      "items": [
        "模型生成的命令不直接运行在宿主机进程",
        "网络可整体关闭（setNetworkPolicy deny-all）",
        "连接凭据留在框架侧，模型只见工具不见密钥"
      ]
    },
    {
      "dot": "emerald",
      "title": "生命周期",
      "items": [
        "environment.open() 启动会话持有的持久沙箱",
        "初始化成功后 checkpoint，进程重启走 resume()，不重跑选择器",
        "stop() 停算力留状态 · delete() 清空重建 · onSessionEnd 兜底清理"
      ]
    },
    {
      "dot": "amber",
      "title": "四种承载",
      "items": [
        "Vercel：快照（生产路径）",
        "Docker：本地镜像（Windows 推荐 Linux 容器）",
        "microsandbox：轻量 VM（win32 不可用）",
        "just-bash：纯 JS 虚拟文件系统兜底，不跑原生进程"
      ]
    },
    {
      "dot": "rose",
      "title": "资源注入",
      "items": [
        "agent/sandbox/workspace/ 种子复制进可写 /workspace",
        "技能树只读暴露在 $HOME/.agents/skills",
        "入站附件写入 /workspace/.eve/attachments/",
        "子 Agent 可 defineParentSandbox() 共享父沙箱"
      ]
    }
  ]
}
