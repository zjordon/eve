  "cards": [
    {
      "dot": "cyan",
      "title": "编译期",
      "items": [
        "discover 阶段零 import 用户代码，只读文件树",
        "产物写入 app 根的 .eve/，运行时只消费产物",
        "authored TS/JS 经 nitro-rolldown 打包并缓存"
      ]
    },
    {
      "dot": "emerald",
      "title": "持久化执行",
      "items": [
        "每个会话是一个 durable workflow run（workflowEntry）",
        "会话历史与快照随 workflow 步骤原子落盘",
        "进程重启后经 provider resume() 恢复，不重跑选择器"
      ]
    },
    {
      "dot": "amber",
      "title": "接口层",
      "items": [
        "TUI、client SDK 与 curl 共用 /eve/v1 会话 API",
        "频道一等公民：Web Chat、Slack、Discord、MCP 等",
        "模型回路支持生成中途引导与 HITL 审批门"
      ]
    },
    {
      "dot": "rose",
      "title": "隔离与依赖",
      "items": [
        "工具在沙箱内执行：Vercel / Docker / microsandbox / just-bash",
        "运行时依赖仅 nitro + undici，其余构建期 vendor",
        "模型看不到连接的 URL 与凭据"
      ]
    }
  ]
